[
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h1",
        "type": "hint",
        "dependencies": [],
        "title": "Equivalent fractions",
        "text": "Fractional equivalence tells us that $$\\frac{a}{b}=\\frac{c}{d}$$ if and only if $$b$$ and $$d$$ are nonzero and $$ad=bc$$.",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h2",
        "type": "hint",
        "dependencies": [
            "a6dd06fbasicalgvidonemodthree13a-h1"
        ],
        "title": "Equivalent fractions",
        "text": "Here we get \\n $$\\frac{x-1}{x+1}=\\frac{-2}{x+1}$$ \\n if and only if $$\\left(x-1\\right) \\left(x+1\\right)=-2\\left(x+1\\right)$$.",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h3",
        "type": "hint",
        "dependencies": [
            "a6dd06fbasicalgvidonemodthree13a-h2"
        ],
        "title": "Add $$2\\left(x+1\\right)$$ to both sides",
        "text": "$$\\left(x-1\\right) \\left(x+1\\right)+2\\left(x+1\\right)=-2\\left(x+1\\right)+2\\left(x+1\\right)=0$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h4",
        "type": "hint",
        "dependencies": [
            "a6dd06fbasicalgvidonemodthree13a-h3"
        ],
        "title": "Factor $$x+1$$ on LHS",
        "text": "$$\\left(x-1\\right) \\left(x+1\\right)+2\\left(x+1\\right)=\\left(x-1+2\\right) \\left(x+1\\right)=0$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h5",
        "type": "hint",
        "dependencies": [
            "a6dd06fbasicalgvidonemodthree13a-h4"
        ],
        "title": "Simplify",
        "text": "$$\\left(x-1+2\\right) \\left(x+1\\right)=\\left(x+1\\right) \\left(x+1\\right)=\\left(x+1\\right)^2=0$$",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h6",
        "type": "hint",
        "dependencies": [
            "a6dd06fbasicalgvidonemodthree13a-h5"
        ],
        "title": "Zero product property",
        "text": "$$\\left(x+1\\right)^2$$ is greater than or equal to zero for all $$x.$$ It is equal to zero only when $$x=-1$$.",
        "variabilization": {},
        "oer": "",
        "license": ""
    },
    {
        "id": "a6dd06fbasicalgvidonemodthree13a-h7",
        "type": "hint",
        "dependencies": [
            "a6dd06fbasicalgvidonemodthree13a-h6"
        ],
        "title": "Conclusion",
        "text": "Notice that when $$x=-1$$, the denominator of the original equation is zero! This is not a valid solution. Therefore there are no solutions to this equation.",
        "variabilization": {},
        "oer": "",
        "license": ""
    }
]